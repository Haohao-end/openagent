        <mxCell id="wf-nodes" value="Configured node classes&#xa;Start / End, LLM, retrieval, tool, HTTP, code,&#xa;if/else, parameter, template, text, variable" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=14;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="970" y="85" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="wf-stream" value="Workflow debug stream&#xa;workflow node results + callable_trace SSE" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="970" y="345" width="290" height="100" as="geometry"/></mxCell>
