        <mxCell id="wf-note" value="The graph follows configured edges; If/Else results select conditional branches. Debug runs persist their WorkflowResult while emitting live events." style="text;html=1;whiteSpace=wrap;fontSize=13;strokeColor=none;fillColor=none;fontColor=#475569;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="570" width="850" height="55" as="geometry"/></mxCell>
        <mxCell id="wf-flow-1" value="validate draft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="wf-draft" target="wf-service"><mxGeometry relative="1" as="geometry"/></mxCell>
